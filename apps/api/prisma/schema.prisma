generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  draft
  intake
  ready_for_estimate
  estimated
  pending
  clarification
  in_tender
  awarded
  active
  completed
}

enum ProjectLinkKind {
  none
  design_active
  construction_pending
}

enum SupplyProfileKind {
  contractor
  designer
}

enum SupplyDirectoryKind {
  contractor
  designer
  supplier
}

enum ContractStatus {
  pending_signatures
  fully_signed
}

enum ContractAddendumStatus {
  pending_signatures
  fully_signed
}

enum ProjectType {
  renovation
  new_build
  extension
  commercial_fitout
  repair
  modernization_reconstruction
  design
  other
}

enum PropertyType {
  residential
  commercial
  industrial_infrastructure
  public
  other
}

enum PropertyOwnershipForm {
  employer_title
  leasehold
  developer_consent
}

enum TagSource {
  client
  ai
}

enum DocumentStatus {
  pending
  uploaded
  deleted
}

enum DocumentCategory {
  blueprint
  photo
  specification
  estimate
  contract
  ownership_certificate
  owners_id
  other
}

enum ContractorVerificationStatus {
  pending
  awaiting_review
  verified
  suspended
  rejected
}

enum ContractorVerificationDocCategory {
  business_license
  registration
  insurance
  owners_id
  portfolio
  other
}

enum TenderStatus {
  draft
  open
  closed
  awarded
  cancelled
}

enum BidStatus {
  clarifying
  enrolled
  submitted
  withdrawn
  selected
  rejected
}

enum BidWithdrawalReason {
  specialization_mismatch
  incomplete_information
  capacity_insufficient
  commercial_terms_unacceptable
  other
}

enum BidOfferAuthor {
  client
  contractor
}

enum AmendmentChangeType {
  clarification
  scope_change
  budget_change
  timeline_change
  other
}

enum ClarificationMode {
  open_chat
  structured_qa
}

model User {
  id               String    @id @default(uuid())
  keycloakSub      String    @unique @map("keycloak_sub")
  email            String?
  displayName      String?   @map("display_name")
  preferredLocale  String    @default("en") @map("preferred_locale")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  projects    Project[]
  documents   Document[]
  contractorProfile ContractorProfile? @relation("ContractorProfileUser")
  contractorReviews ContractorProfile[] @relation("ContractorReviewedBy")
  contractorVerificationDocuments ContractorVerificationDocument[]
  bidMessages BidMessage[]
  bidOffers   BidOffer[]
  bidChatPresence BidChatPresence[]
  tenderClarificationAnswers TenderClarificationQuestion[] @relation("ClarificationAnsweredBy")
  clarificationAnswerAttachments ClarificationAnswerAttachment[]
  notificationPreferences UserNotificationPreferences?
  contractorReviewsSubmitted ContractorProjectReview[] @relation("ReviewClient")
  projectReviewAttachments ProjectReviewAttachment[]
  notificationEmailLogs   NotificationEmailLog[]
  inAppNotifications      InAppNotification[]
  tenderInvitesSent       TenderInvite[]
  contractAddendaCreated  ContractAddendum[] @relation("ContractAddendumCreatedBy")
  contractAddendumAttachments ContractAddendumAttachment[]
  signatureRequestsCreated ContractSignatureRequest[] @relation("SignatureRequestRequestedBy")
  signatureRequestsReviewed ContractSignatureRequest[] @relation("SignatureRequestReviewedBy")

  @@map("users")
}

model UserNotificationPreferences {
  userId                 String   @id @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled           Boolean  @default(true) @map("email_enabled")
  emailClientBidActivity Boolean  @default(true) @map("email_client_bid_activity")
  emailContractorUpdates Boolean  @default(true) @map("email_contractor_updates")
  emailMatchingProjects  Boolean  @default(true) @map("email_matching_projects")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("user_notification_preferences")
}

enum NotificationEmailKind {
  client_bid_enrolled
  client_bid_submitted
  client_clarification_questions
  client_tender_deadline_reached
  contractor_counter_offer
  contractor_bid_message
  contractor_bid_selected
  contractor_bid_rejected
  contractor_project_awarded
  contractor_matching_project
  contractor_tender_opened
  contract_party_signed
  contract_fully_signed
  contract_addendum_created
  contract_addendum_party_signed
  contract_addendum_fully_signed
  contract_terms_updated
  tender_resumed
  client_contractor_withdrew_award
  client_contractor_declined_proposal
  contractor_award_released
  contractor_verification_approved
  contractor_verification_rejected
  admin_signature_request_created
  contractor_signature_request_approved
  contractor_signature_request_rejected
}

model NotificationEmailLog {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationEmailKind
  projectId String?               @map("project_id")
  sentAt    DateTime              @default(now()) @map("sent_at")

  @@index([userId, kind, sentAt])
  @@map("notification_email_logs")
}

enum InAppNotificationKind {
  client_bid_submitted
  client_bid_enrolled
  client_clarification_questions
  client_bid_message
  client_tender_deadline_reached
  client_contractor_declined_proposal
  contractor_counter_offer
  contractor_bid_selected
  contract_terms_updated
  contract_party_signed
  contract_fully_signed
  contract_addendum_created
  contract_addendum_party_signed
  contract_addendum_fully_signed
  admin_signature_request_created
  contractor_signature_request_approved
  contractor_signature_request_rejected
}

enum ContractSignatureRequestStatus {
  pending
  approved
  rejected
}

model InAppNotification {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      InAppNotificationKind
  href      String?
  projectId String?               @map("project_id")
  payload   Json?
  readAt    DateTime?             @map("read_at")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("in_app_notifications")
}

model TagGroup {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  tags      Tag[]

  @@map("tag_groups")
}

model Tag {
  id        String       @id @default(uuid())
  slug      String       @unique
  label     String
  groupId   String?      @map("group_id")
  group     TagGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isSystem  Boolean      @default(true) @map("is_system")
  createdAt DateTime     @default(now()) @map("created_at")
  projects  ProjectTag[]

  @@index([groupId])
  @@map("tags")
}

model Project {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  client         User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  projectType    ProjectType   @default(other) @map("project_type")
  propertyType   PropertyType? @map("property_type")
  propertyOwnershipForm PropertyOwnershipForm? @map("property_ownership_form")
  district       String?
  locationRegionSlug String   @default("bangkok") @map("location_region_slug")
  locationAreaSlug   String?  @map("location_area_slug")
  locationNote       String?  @map("location_note")
  regionCode     String        @default("TH") @map("region_code")
  status         ProjectStatus @default(draft)
  isHidden       Boolean       @default(false) @map("is_hidden")
  readinessScore Int           @default(0) @map("readiness_score")
  briefJson      Json?         @map("brief_json")
  clarificationMode ClarificationMode @default(open_chat) @map("clarification_mode")
  clarificationSummary String?  @map("clarification_summary") @db.Text
  scopeSummary         String?  @map("scope_summary") @db.Text
  sourceLocale         String   @default("en") @map("source_locale")
  tenderContractTermsJson Json? @map("tender_contract_terms_json")
  linkedProjectId      String?          @unique @map("linked_project_id")
  linkedProject        Project?         @relation("ProjectLink", fields: [linkedProjectId], references: [id], onDelete: SetNull)
  linkedFrom           Project?         @relation("ProjectLink")
  linkKind             ProjectLinkKind  @default(none) @map("link_kind")
  statusBeforePending  ProjectStatus?   @map("status_before_pending")
  designFeePercent     Float?           @map("design_fee_percent")
  baseConstructionTotalsJson Json?      @map("base_construction_totals_json")
  estimateRefinementQaJson Json?        @map("estimate_refinement_qa_json")
  estimateAdjustmentsJson Json?       @map("estimate_adjustments_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tags           ProjectTag[]
  documents      Document[]
  estimates      Estimate[]
  tender         Tender?
  amendments     ProjectAmendment[]
  contractorReview ContractorProjectReview?
  reviewAttachments ProjectReviewAttachment[]
  /// Set when admin approves a contractor signature/fee request. Persists if signatures are later cleared.
  platformFeePaid Boolean @default(false) @map("platform_fee_paid")
  contract        Contract?
  contractAddenda ContractAddendum[]
  contentTranslations ContentTranslation[]
  tenderInvites   TenderInvite[]
  signatureRequests ContractSignatureRequest[]

  @@index([clientId])
  @@index([clientId, isHidden])
  @@index([projectType])
  @@index([locationRegionSlug])
  @@index([linkKind])
  @@map("projects")
}

model ContentTranslation {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldKey       String   @map("field_key")
  targetLocale   String   @map("target_locale")
  sourceLocale   String   @map("source_locale")
  sourceHash     String   @map("source_hash")
  translatedText String   @map("translated_text") @db.Text
  provider       String   @default("openai")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([projectId, fieldKey, targetLocale])
  @@index([projectId, targetLocale])
  @@map("content_translations")
}

model ProjectTag {
  projectId String    @map("project_id")
  tagId     String    @map("tag_id")
  source    TagSource @default(client)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

model Document {
  id                  String           @id @default(uuid())
  projectId           String           @map("project_id")
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId          String           @map("uploader_id")
  uploader            User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  originalName        String           @map("original_name")
  contentType         String           @map("content_type")
  sizeBytes           Int?             @map("size_bytes")
  storageKey          String           @unique @map("storage_key")
  thumbnailStorageKey String?          @unique @map("thumbnail_storage_key")
  category            DocumentCategory @default(other)
  status              DocumentStatus   @default(pending)
  createdAt           DateTime         @default(now()) @map("created_at")
  uploadedAt          DateTime?        @map("uploaded_at")

  @@index([projectId])
  @@index([uploaderId])
  @@map("documents")
}

model Estimate {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  type        String   @default("ballpark")
  currency    String   @default("THB")
  totalsJson  Json     @map("totals_json")
  linesJson   Json     @map("lines_json")
  confidence  Float
  disclaimer  String
  metaJson    Json?    @map("meta_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("estimates")
}

model ProjectAmendment {
  id           String               @id @default(uuid())
  projectId    String               @map("project_id")
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body         String
  changeType   AmendmentChangeType? @map("change_type")
  createdAt    DateTime             @default(now()) @map("created_at")
  processedAt  DateTime?            @map("processed_at")
  aiResultJson Json?                @map("ai_result_json")

  @@index([projectId])
  @@index([projectId, processedAt])
  @@map("project_amendments")
}

model ContractorProfile {
  id                      String                       @id @default(uuid())
  userId                  String                       @unique @map("user_id")
  user                    User                         @relation("ContractorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  kind                    SupplyProfileKind            @default(contractor)
  companyName             String?                      @map("company_name")
  phone                   String?
  bankName                String?                      @map("bank_name")
  bankAccount             String?                      @map("bank_account")
  regionCode              String                       @default("TH") @map("region_code")
  serviceLocationsJson    Json                         @default("[{\"regionSlug\":\"bangkok\"}]") @map("service_locations_json")
  projectTypes            ProjectType[]                @default([]) @map("project_types")
  tagSlugs                String[]                     @default([]) @map("tag_slugs")
  verificationStatus      ContractorVerificationStatus @default(pending) @map("verification_status")
  verificationComment     String?                      @map("verification_comment")
  verificationRequestedAt DateTime?                    @map("verification_requested_at")
  verificationReviewedAt  DateTime?                    @map("verification_reviewed_at")
  reviewedById            String?                      @map("reviewed_by_id")
  reviewedBy              User?                        @relation("ContractorReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  bids                    Bid[]
  verificationDocuments   ContractorVerificationDocument[]
  portfolioItems          ContractorPortfolioItem[]
  projectReviews          ContractorProjectReview[]
  signatureRequests       ContractSignatureRequest[]

  @@index([regionCode])
  @@index([verificationStatus])
  @@index([kind])
  @@map("contractor_profiles")
}

model ContractorVerificationDocument {
  id           String                          @id @default(uuid())
  contractorId String                          @map("contractor_id")
  contractor   ContractorProfile               @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  uploaderId   String                          @map("uploader_id")
  uploader     User                            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  originalName String                          @map("original_name")
  contentType  String                          @map("content_type")
  sizeBytes    Int?                            @map("size_bytes")
  storageKey   String                          @unique @map("storage_key")
  category     ContractorVerificationDocCategory @default(other)
  status       DocumentStatus                  @default(pending)
  createdAt    DateTime                        @default(now()) @map("created_at")
  uploadedAt   DateTime?                       @map("uploaded_at")

  @@index([contractorId])
  @@map("contractor_verification_documents")
}

model ContractorPortfolioItem {
  id                  String            @id @default(uuid())
  contractorId        String            @map("contractor_id")
  contractor          ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  title               String
  description         String?           @db.Text
  originalName        String            @map("original_name")
  contentType         String            @map("content_type")
  sizeBytes           Int?              @map("size_bytes")
  storageKey          String            @unique @map("storage_key")
  thumbnailStorageKey String?           @unique @map("thumbnail_storage_key")
  sortOrder           Int               @default(0) @map("sort_order")
  status              DocumentStatus    @default(pending)
  createdAt           DateTime          @default(now()) @map("created_at")
  uploadedAt          DateTime?         @map("uploaded_at")

  @@index([contractorId, sortOrder])
  @@map("contractor_portfolio_items")
}

model Tender {
  id           String       @id @default(uuid())
  projectId    String       @unique @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       TenderStatus @default(draft)
  currency     String       @default("THB")
  minBids      Int          @default(1) @map("min_bids")
  opensAt      DateTime?    @map("opens_at")
  closesAt     DateTime?    @map("closes_at")
  deadlineNotifiedAt DateTime? @map("deadline_notified_at")
  awardedBidId String?      @unique @map("awarded_bid_id")
  awardedBid   Bid?         @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  bidAnalysisJson Json?       @map("bid_analysis_json")
  defaultCostBreakdown Json?  @map("default_cost_breakdown")
  nextContenderNumber Int     @default(1) @map("next_contender_number")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  bids         Bid[]        @relation("TenderBids")
  clarificationQuestions TenderClarificationQuestion[]
  invites      TenderInvite[]

  @@index([status])
  @@map("tenders")
}

model Bid {
  id           String            @id @default(uuid())
  tenderId     String            @map("tender_id")
  tender       Tender            @relation("TenderBids", fields: [tenderId], references: [id], onDelete: Cascade)
  contractorId String            @map("contractor_id")
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  status       BidStatus         @default(clarifying)
  amount       Decimal?          @db.Decimal(14, 2)
  durationDays Int?              @map("duration_days")
  termsJson    Json?             @map("terms_json")
  contenderNumber Int?           @map("contender_number")
  enrolledAt   DateTime?         @map("enrolled_at")
  submittedAt  DateTime?         @map("submitted_at")
  withdrawalReason BidWithdrawalReason? @map("withdrawal_reason")
  withdrawalNote   String?              @map("withdrawal_note")
  withdrawnAt      DateTime?            @map("withdrawn_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  awardedTender Tender?          @relation("AwardedBid")
  messages     BidMessage[]
  offers       BidOffer[]
  chatPresence BidChatPresence[]
  clarificationSubmission BidClarificationSubmission?
  projectReview           ContractorProjectReview?
  contract                Contract?

  @@unique([tenderId, contractorId])
  @@index([tenderId])
  @@index([contractorId])
  @@map("bids")
}

model BidMessage {
  id        String   @id @default(uuid())
  bidId     String   @map("bid_id")
  bid       Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bidId])
  @@map("bid_messages")
}

model BidChatPresence {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bidId      String   @map("bid_id")
  bid        Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @map("last_seen_at")

  @@id([userId, bidId])
  @@index([bidId, lastSeenAt])
  @@map("bid_chat_presence")
}

model BidOffer {
  id           String          @id @default(uuid())
  bidId        String          @map("bid_id")
  bid          Bid             @relation(fields: [bidId], references: [id], onDelete: Cascade)
  authorRole   BidOfferAuthor  @map("author_role")
  authorId     String          @map("author_id")
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(14, 2)
  durationDays Int?            @map("duration_days")
  termsJson    Json?           @map("terms_json")
  note         String?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([bidId])
  @@map("bid_offers")
}

model BidClarificationSubmission {
  id          String   @id @default(uuid())
  bidId       String   @unique @map("bid_id")
  bid         Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  questions   Json
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@map("bid_clarification_submissions")
}

model TenderClarificationQuestion {
  id           String    @id @default(uuid())
  tenderId     String    @map("tender_id")
  tender       Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  questionText String    @map("question_text")
  sortOrder    Int       @default(0) @map("sort_order")
  answer       String?   @db.Text
  answeredAt   DateTime? @map("answered_at")
  answeredById String?   @map("answered_by_id")
  answeredBy   User?     @relation("ClarificationAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  sourceBidIds String[]  @default([]) @map("source_bid_ids")
  attachments  ClarificationAnswerAttachment[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([tenderId, sortOrder])
  @@map("tender_clarification_questions")
}

model ClarificationAnswerAttachment {
  id           String                      @id @default(uuid())
  questionId   String                      @map("question_id")
  question     TenderClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  uploaderId   String                      @map("uploader_id")
  uploader     User                        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  originalName String                      @map("original_name")
  contentType  String                      @map("content_type")
  sizeBytes    Int?                        @map("size_bytes")
  storageKey   String                      @unique @map("storage_key")
  status       DocumentStatus              @default(pending)
  createdAt    DateTime                    @default(now()) @map("created_at")
  uploadedAt   DateTime?                   @map("uploaded_at")

  @@index([questionId])
  @@map("clarification_answer_attachments")
}

model ContractorProjectReview {
  id           String            @id @default(uuid())
  projectId    String            @unique @map("project_id")
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String            @map("client_id")
  client       User              @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  contractorId String            @map("contractor_id")
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  bidId        String            @unique @map("bid_id")
  bid          Bid               @relation(fields: [bidId], references: [id], onDelete: Cascade)
  comment      String?           @db.Text
  ratingsJson  Json              @map("ratings_json")
  createdAt    DateTime          @default(now()) @map("created_at")
  attachments  ProjectReviewAttachment[]

  @@index([contractorId])
  @@index([clientId])
  @@map("contractor_project_reviews")
}

model ProjectReviewAttachment {
  id           String                   @id @default(uuid())
  projectId    String                   @map("project_id")
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String                   @map("client_id")
  client       User                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewId     String?                  @map("review_id")
  review       ContractorProjectReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  originalName String                   @map("original_name")
  contentType  String                   @map("content_type")
  sizeBytes    Int                      @map("size_bytes")
  storageKey   String                   @unique @map("storage_key")
  status       DocumentStatus           @default(pending)
  uploadedAt   DateTime?                @map("uploaded_at")
  createdAt    DateTime                 @default(now()) @map("created_at")

  @@index([projectId])
  @@index([reviewId])
  @@map("project_review_attachments")
}

model Contract {
  id                       String         @id @default(uuid())
  projectId                String         @unique @map("project_id")
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bidId                    String         @unique @map("bid_id")
  bid                      Bid            @relation(fields: [bidId], references: [id], onDelete: Cascade)
  status                   ContractStatus @default(pending_signatures)
  clientSignedAt           DateTime?      @map("client_signed_at")
  contractorSignedAt       DateTime?      @map("contractor_signed_at")
  clientSignatureDataUrl   String?        @map("client_signature_data_url") @db.Text
  contractorSignatureDataUrl String?      @map("contractor_signature_data_url") @db.Text
  englishBodyHtml          String?        @map("english_body_html") @db.Text
  customFileStorageKey       String?      @unique @map("custom_file_storage_key")
  customFileOriginalName     String?      @map("custom_file_original_name")
  customFileContentType      String?      @map("custom_file_content_type")
  customFileSizeBytes        Int?         @map("custom_file_size_bytes")
  customFileUploadedByUserId String?      @map("custom_file_uploaded_by_user_id")
  customFileUploadedAt       DateTime?    @map("custom_file_uploaded_at")
  /// Original DOCX kept when the party uploaded DOCX (PDF is stored in customFile* for preview).
  sourceDocxStorageKey       String?      @unique @map("source_docx_storage_key")
  sourceDocxOriginalName     String?      @map("source_docx_original_name")
  sourceDocxSizeBytes        Int?         @map("source_docx_size_bytes")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  addenda                  ContractAddendum[]
  signatureRequests        ContractSignatureRequest[]

  @@map("contracts")
}

model ContractSignatureRequest {
  id              String                         @id @default(uuid())
  projectId       String                         @map("project_id")
  project         Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId      String                         @map("contract_id")
  contract        Contract                       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractorId    String                         @map("contractor_id")
  contractor      ContractorProfile              @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  requestedById   String                         @map("requested_by_id")
  requestedBy     User                           @relation("SignatureRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  status          ContractSignatureRequestStatus @default(pending)
  contractAmount  Decimal?                       @map("contract_amount") @db.Decimal(14, 2)
  currency        String                         @default("THB")
  accessFeeUsd    Decimal                        @map("access_fee_usd") @db.Decimal(10, 2)
  dueNowListed    Decimal?                       @map("due_now_listed") @db.Decimal(14, 2)
  dueNowPayable   Decimal                        @default(0) @map("due_now_payable") @db.Decimal(14, 2)
  successFeeGross Decimal?                       @map("success_fee_gross") @db.Decimal(14, 2)
  trialActive     Boolean                        @default(true) @map("trial_active")
  bankName        String?                        @map("bank_name")
  bankAccount     String?                        @map("bank_account")
  companyName     String?                        @map("company_name")
  rejectionReason String?                        @map("rejection_reason") @db.Text
  reviewedById    String?                        @map("reviewed_by_id")
  reviewedBy      User?                          @relation("SignatureRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?                      @map("reviewed_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([contractorId])
  @@map("contract_signature_requests")
}

model ContractAddendum {
  id                         String                 @id @default(uuid())
  contractId                 String                 @map("contract_id")
  contract                   Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  projectId                  String                 @map("project_id")
  project                    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById                String                 @map("created_by_id")
  createdBy                  User                   @relation("ContractAddendumCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  title                      String
  sourceDescription          String?                @map("source_description") @db.Text
  englishBodyHtml            String?                @map("english_body_html") @db.Text
  /// Locale of the TipTap/AI body (en | ru | th). Column name kept for TipTap parity with Contract.
  bodyLocale                 String                 @default("en") @map("body_locale")
  status                     ContractAddendumStatus @default(pending_signatures)
  contractorSignedAt         DateTime?              @map("contractor_signed_at")
  clientSignedAt             DateTime?              @map("client_signed_at")
  contractorSignatureDataUrl String?                @map("contractor_signature_data_url") @db.Text
  clientSignatureDataUrl     String?                @map("client_signature_data_url") @db.Text
  customFileStorageKey       String?                @unique @map("custom_file_storage_key")
  customFileOriginalName     String?                @map("custom_file_original_name")
  customFileContentType      String?                @map("custom_file_content_type")
  customFileSizeBytes        Int?                   @map("custom_file_size_bytes")
  customFileUploadedByUserId String?                @map("custom_file_uploaded_by_user_id")
  customFileUploadedAt       DateTime?              @map("custom_file_uploaded_at")
  /// Original DOCX kept when the party uploaded DOCX (PDF is stored in customFile* for preview).
  sourceDocxStorageKey       String?                @unique @map("source_docx_storage_key")
  sourceDocxOriginalName     String?                @map("source_docx_original_name")
  sourceDocxSizeBytes        Int?                   @map("source_docx_size_bytes")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  attachments                ContractAddendumAttachment[]

  @@index([contractId])
  @@index([projectId])
  @@map("contract_addenda")
}

model ContractAddendumAttachment {
  id           String            @id @default(uuid())
  addendumId   String            @map("addendum_id")
  addendum     ContractAddendum  @relation(fields: [addendumId], references: [id], onDelete: Cascade)
  uploaderId   String            @map("uploader_id")
  uploader     User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  originalName String            @map("original_name")
  contentType  String            @map("content_type")
  sizeBytes    Int?              @map("size_bytes")
  storageKey   String            @unique @map("storage_key")
  status       DocumentStatus    @default(pending)
  createdAt    DateTime          @default(now()) @map("created_at")
  uploadedAt   DateTime?         @map("uploaded_at")

  @@index([addendumId])
  @@map("contract_addendum_attachments")
}

model SupplyDirectoryEntry {
  id          String              @id @default(uuid())
  kind        SupplyDirectoryKind
  companyName String              @map("company_name")
  contactName String?             @map("contact_name")
  email       String
  phone       String?
  website     String?
  regionSlug  String?             @map("region_slug")
  notes       String?             @db.Text
  isActive    Boolean             @default(true) @map("is_active")
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  invites     TenderInvite[]

  @@index([kind, isActive, sortOrder])
  @@index([email])
  @@map("supply_directory_entries")
}

model TenderInvite {
  id              String               @id @default(uuid())
  tenderId        String               @map("tender_id")
  tender          Tender               @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  projectId       String               @map("project_id")
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  directoryEntryId String?             @map("directory_entry_id")
  directoryEntry  SupplyDirectoryEntry? @relation(fields: [directoryEntryId], references: [id], onDelete: SetNull)
  invitedById     String               @map("invited_by_id")
  invitedBy       User                 @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  kind            SupplyDirectoryKind
  recipientEmail  String               @map("recipient_email")
  recipientName   String?              @map("recipient_name")
  tokenHash       String               @unique @map("token_hash")
  sentAt          DateTime?            @map("sent_at")
  openedAt        DateTime?            @map("opened_at")
  expiresAt       DateTime?            @map("expires_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([tenderId])
  @@index([projectId])
  @@index([recipientEmail])
  @@map("tender_invites")
}

/// Singleton platform config (id = "default").
model PlatformSettings {
  id                         String   @id @default("default")
  contractSignedNotifyEmails String[] @default([]) @map("contract_signed_notify_emails")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
