DATABASE_URL=postgresql://platform:change_me@localhost:5432/platform
KEYCLOAK_ISSUER=https://iabuilding.duckdns.org/auth/realms/construction-marketplace
KEYCLOAK_JWKS_URI=https://iabuilding.duckdns.org/auth/realms/construction-marketplace/protocol/openid-connect/certs
# Public web app URL (notification email links)
WEB_APP_URL=https://www.builthai.com
# Must be builthai.com — not buildthai.com (typo breaks email links).

# SMTP via Resend — https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxx
SMTP_FROM=noreply@builthai.com
SMTP_FROM_NAME=BuilTHAI
# Admin Settings “Send message” — defaults to hello@builthai.com if unset
SMTP_BROADCAST_FROM=hello@builthai.com
# SMTP_BROADCAST_FROM_NAME=BuilTHAI
# Admin inbox for ops emails (platform fee invoice after contract fully signed).
# Defaults to legal contact email from contractor agreement if unset.
PLATFORM_ADMIN_EMAIL=hello@builthai.com

# OpenAI — project intake (optional; uses rule-based fallback if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Sentry (API project, separate from web) ---
# DSN: Sentry → Settings → Projects → your-api-project → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o123.ingest.de.sentry.io/789
# Optional
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
