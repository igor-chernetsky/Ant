# Copy to .env.local for local development

NEXT_PUBLIC_KEYCLOAK_URL=https://iabuilding.duckdns.org/auth
NEXT_PUBLIC_KEYCLOAK_REALM=construction-marketplace
NEXT_PUBLIC_API_URL=https://iabuilding.duckdns.org/api
NEXT_PUBLIC_APP_URL=https://www.builthai.com
# Must be builthai.com — not buildthai.com (typo breaks verification links).
# Server-side fallback for emails when set on Vercel:
# WEB_APP_URL=https://www.builthai.com
# Optional: force OG image host if custom domain DNS is not on Vercel yet
# NEXT_PUBLIC_OG_ASSET_ORIGIN=https://your-app.vercel.app

# Server-only — never use NEXT_PUBLIC_ prefix for the secret
KEYCLOAK_BFF_CLIENT_ID=platform-bff
KEYCLOAK_BFF_CLIENT_SECRET=set-in-keycloak-admin-credentials-tab

# Sign up (creates users via Keycloak Admin API) — same admin as Keycloak bootstrap on EC2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-keycloak-admin-password-from-infra-env

# App-sent verification email (recommended for production — link stays on your domain)
EMAIL_VERIFICATION_SECRET=generate-a-long-random-string-at-least-32-chars
# Resend SMTP — https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxx  # Resend API key
SMTP_FROM=noreply@builthai.com
SMTP_FROM_NAME=BuilTHAI

# Google Maps (home search map) — also accepts GOOGLE_MAPS_API_KEY on Vercel
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# SKIP_EMAIL_VERIFICATION=true

# --- Sentry (web project: javascript-nextjs) ---
# DSN: Sentry → Settings → Projects → javascript-nextjs → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o123.ingest.de.sentry.io/456
# Optional: same DSN for Next.js server/edge if NEXT_PUBLIC_* is unset at build
# SENTRY_DSN=
# Sentry org slug (for source map upload at build time; default home-1ox in next.config)
# SENTRY_ORG=home-1ox
# SENTRY_PROJECT=javascript-nextjs
# Build-only on Vercel — NOT the "Security Token" under Settings → Security.
# Create: Sentry → Settings → Auth Tokens → Create New Token
# Scopes: project:releases, org:read (or "Release" / source map upload preset)
SENTRY_AUTH_TOKEN=
# Optional
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
