# Copy to infra/.env on the EC2 host (never commit .env)

# --- Public URLs (used by browsers and JWT issuer validation) ---
PUBLIC_BASE_URL=https://iabuilding.duckdns.org
API_PUBLIC_URL=https://iabuilding.duckdns.org/api
KEYCLOAK_PUBLIC_URL=https://iabuilding.duckdns.org/auth
# Hostname only (no scheme) — Keycloak KC_HOSTNAME
KEYCLOAK_HOSTNAME=iabuilding.duckdns.org
KEYCLOAK_REALM=construction-marketplace

# --- PostgreSQL ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=platform

# --- Keycloak admin (bootstrap only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# --- Keycloak DB (same Postgres instance, separate database) ---
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- AWS S3 (recommended) — do NOT set S3_ENDPOINT / S3_PUBLIC_ENDPOINT ---
S3_BUCKET=ant1-backet
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
S3_FORCE_PATH_STYLE=false
# Apply CORS once: bash scripts/setup-aws-s3.sh

# --- MinIO (alternative, on EC2) — uncomment and set COMPOSE_PROFILES=full ---
# COMPOSE_PROFILES=full
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change_me_minio_password
# S3_BUCKET=platform-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://iabuilding.duckdns.org/storage
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=change_me_minio_password
# S3_FORCE_PATH_STYLE=true

# --- App API (optional) ---
KEYCLOAK_CLIENT_ID=platform-api
KEYCLOAK_CLIENT_SECRET=

# OpenAI intake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Email notifications (API → Resend SMTP) ---
WEB_APP_URL=https://www.builthai.com
# Must be builthai.com — not buildthai.com (typo breaks email links).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxx
SMTP_FROM=noreply@builthai.com
SMTP_FROM_NAME=BuilTHAI
# Admin Settings broadcast (defaults to hello@builthai.com)
SMTP_BROADCAST_FROM=hello@builthai.com
# Optional HMAC secret for List-Unsubscribe tokens (defaults to SMTP_PASSWORD)
# EMAIL_UNSUBSCRIBE_SECRET=
# Ops inbox after contract fully signed (invoice contractor for 2% platform fee)
PLATFORM_ADMIN_EMAIL=hello@builthai.com
# Admin ops alerts (fee invoice, signature request, verification, …).
# Chat ID for a channel is usually like -100xxxxxxxxxx (bot must be channel admin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Daily Postgres backup to S3 ---
BACKUP_S3_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=14

# --- Sentry (NestJS API — runtime only on EC2) ---
# DSN from the API Sentry project (not javascript-nextjs). No auth token needed on EC2
# unless you upload source maps from the server build.
SENTRY_DSN=https://examplePublicKey@o123.ingest.de.sentry.io/789
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# NODE_ENV=production
# DATABASE_URL=postgresql://platform:change_me_strong_password@postgres:5432/platform
